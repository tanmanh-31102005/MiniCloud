# ==============================================================================
# MyMiniCloud - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR SECRETS (DO NOT COMMIT .env TO GIT)
# ==============================================================================

# Project & Docker Settings
COMPOSE_PROJECT_NAME=myminicloud
DOCKERHUB_USERNAME=your_dockerhub_username

# MariaDB Configuration
MARIADB_ROOT_PASSWORD=your_secure_root_password
MARIADB_DATABASE=studentdb
MARIADB_USER=clouduser
MARIADB_PASSWORD=your_secure_db_password

# Keycloak Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_secure_keycloak_password
KEYCLOAK_REALM=MyMiniCloud
KEYCLOAK_CLIENT_ID=flask-app

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_secure_minio_password
MINIO_BUCKET_PROFILE=profile-pics
MINIO_BUCKET_DOCS=documents

# Grafana Configuration
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_secure_grafana_password
