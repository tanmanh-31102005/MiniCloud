# ==============================================================================
# MyMiniCloud — Production Environment Configuration for AWS EC2
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env on your AWS EC2 instance:
#    cp .env.production.example .env
# 2. Replace the placeholders below with your actual values and strong secrets.
# 3. DO NOT commit your live .env file to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Project & Docker Hub Settings
# ------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=myminicloud
DOCKERHUB_USERNAME=your_dockerhub_username
IMAGE_TAG=1.0.0

# ------------------------------------------------------------------------------
# 2. AWS EC2 Public Host / Domain Setting
# ------------------------------------------------------------------------------
# Set to your AWS EC2 Public IPv4 or Elastic IP (e.g. 54.210.123.45)
PUBLIC_IP=your_ec2_public_ip

# ------------------------------------------------------------------------------
# 3. MariaDB Database Credentials (Must be strong, random strings)
# ------------------------------------------------------------------------------
MARIADB_ROOT_PASSWORD=replace_with_strong_random_mariadb_root_password
MARIADB_DATABASE=studentdb
MARIADB_USER=clouduser
MARIADB_PASSWORD=replace_with_strong_random_db_password

# ------------------------------------------------------------------------------
# 4. Keycloak IAM Admin Credentials
# ------------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace_with_strong_random_keycloak_password
KEYCLOAK_REALM=MyMiniCloud
KEYCLOAK_CLIENT_ID=flask-app

# ------------------------------------------------------------------------------
# 5. MinIO Object Storage Root Credentials
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_with_strong_random_minio_password
MINIO_BUCKET_PROFILE=profile-pics
MINIO_BUCKET_DOCS=documents

# ------------------------------------------------------------------------------
# 6. Grafana Dashboard Administrator Credentials
# ------------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace_with_strong_random_grafana_password
